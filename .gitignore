# DPM Database und große Dateien
codebook/*.zip
codebook/*.accdb
codebook/*.pdf
codebook/*.xlsx

# Raw Downloads (bei Phase 1 erzeugt)
raw/*.zip
raw/*.csv

# Processed Outputs (wird erzeugt) — CSV nur wenn klein
processed/*.parquet
processed/*.csv.gz
# Pipeline-Zustand: long_form_raw.csv (>100 MB @ Voll-Load) und die Coverage-Matrix
# wachsen mit dem Bestand und sind abgeleitet. Sie leben auf dem `data`-Branch unter
# state/ (publish_data_branch.sh) und werden mit scripts/fetch_state.sh geholt —
# so bleibt main klein und es gibt keine zwei divergierenden Wahrheiten.
processed/long_form_raw.csv
processed/filing_indicators.csv

# Notebooks Checkpoints
notebooks/.ipynb_checkpoints/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# captured live request may contain session tokens
interim/edap_recon/query_request.json
interim/edap_recon/query_response.json

# Download-Plan, bei jedem Lauf neu erzeugt (plan_delta.py)
interim/edap_recon/manifest_todo.csv

# Roh-Layer: die von EDAP geladenen ZIPs (download_raw_reports.py). Jederzeit
# neu ladbar, aber im Voll-Load hunderte MB — ein `git add -A` würde sie sonst
# einsaugen. Der Workflow committet zwar nur eine explizite Liste, lokal ist es
# aber eine Falle. Das entpackte Referenzbeispiel interim/sample_DE/ bleibt
# bewusst versioniert.
interim/raw_reports/

# Zweig B analytics artifacts (regenerable via build_zweig_b.py)
processed/long/

# Zweig A JSON data — lives on the orphan `data` branch (served via jsDelivr),
# regenerable via build_zweig_a_shards.py + publish_data_branch.sh. Kept out of
# main so the shard tree never bloats main's history.
processed/zweig_a/data/

# Placement-Guard: Report wird bei jedem Lauf neu erzeugt (die Baseline dagegen
# ist der committete Vertrag und gehört ins Repo).
interim/placement_report.csv
interim/unit_consistency_report.csv
